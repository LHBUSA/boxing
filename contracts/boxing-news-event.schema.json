{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://propbetedge.ai/contracts/boxing-news-event.schema.json",
  "title": "PropBetEdge Boxing News Event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_type",
    "dedupe_key",
    "detected_at",
    "confidence",
    "facts",
    "sources"
  ],
  "properties": {
    "event_type": {
      "type": "string",
      "enum": [
        "FIGHT_ANNOUNCED",
        "OPPONENT_REPLACED",
        "BOUT_CANCELLED",
        "EVENT_POSTPONED",
        "TITLE_STATUS_CHANGED",
        "RANKING_CHANGED",
        "OFFICIALS_ASSIGNED",
        "WEIGH_IN_RECORDED",
        "WEIGHT_MISSED",
        "MARKET_MOVED",
        "RESULT_OFFICIAL",
        "SCORECARD_POSTED",
        "SUSPENSION_STATUS_CHANGED",
        "OTHER"
      ]
    },
    "dedupe_key": {
      "type": "string",
      "minLength": 1
    },
    "occurred_at": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "detected_at": {
      "type": "string",
      "format": "date-time"
    },
    "confidence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "entity_refs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fighter_ids": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "bout_id": { "type": ["string", "null"] },
        "event_id": { "type": ["string", "null"] },
        "organization_ids": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "commission_id": { "type": ["string", "null"] }
      }
    },
    "facts": {
      "type": "object",
      "description": "Canonical structured facts permitted to flow into downstream story fact blocks. Unknown values must be absent or null; never fabricated."
    },
    "derived": {
      "type": "object",
      "description": "Optional PropBetEdge-derived context. Every derived block must carry its metric/model version.",
      "additionalProperties": true,
      "properties": {
        "version": { "type": "string" }
      },
      "required": ["version"]
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_key", "observed_at"],
        "properties": {
          "source_key": { "type": "string" },
          "source_url": { "type": ["string", "null"], "format": "uri" },
          "external_key": { "type": ["string", "null"] },
          "observed_at": { "type": "string", "format": "date-time" },
          "observation_id": { "type": ["string", "null"] }
        }
      }
    },
    "requires_human_review": {
      "type": "boolean",
      "default": false
    }
  }
}
