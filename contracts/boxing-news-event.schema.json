{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://propbetedge.ai/contracts/boxing-news-event.schema.json",
  "title": "PropBetEdge Boxing News Event",
  "description": "Structured change event emitted by boxing-core/odds/rankings workers and consumed by boxing-news. Version 1.1.0 aligns event types with public.boxing_news_events (migration 20260912000003).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "event_type",
    "dedupe_key",
    "detected_at",
    "confidence",
    "facts",
    "sources"
  ],
  "properties": {
    "contract_version": {
      "type": "string",
      "const": "1.1.0"
    },
    "event_type": {
      "type": "string",
      "enum": [
        "FIGHT_ANNOUNCED",
        "OPPONENT_REPLACED",
        "FIGHT_CANCELLED",
        "FIGHT_POSTPONED",
        "EVENT_CANCELLED",
        "EVENT_POSTPONED",
        "VENUE_CHANGED",
        "TITLE_WON",
        "TITLE_VACATED",
        "TITLE_STRIPPED",
        "TITLE_STATUS_CHANGED",
        "RANKING_CHANGED",
        "WEIGH_IN_RESULT",
        "WEIGHT_MISSED",
        "OFFICIALS_ASSIGNED",
        "RESULT_OFFICIAL",
        "RESULT_OVERTURNED",
        "SCORECARD_POSTED",
        "SUSPENSION_POSTED",
        "MARKET_MOVED",
        "OTHER"
      ]
    },
    "dedupe_key": {
      "type": "string",
      "minLength": 1,
      "description": "Deterministic key over the underlying state change. The same upstream change observed twice must produce the same key."
    },
    "supersedes_dedupe_key": {
      "type": ["string", "null"],
      "description": "Set when this event corrects an earlier event (e.g. a corrected scorecard)."
    },
    "occurred_at": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "detected_at": {
      "type": "string",
      "format": "date-time"
    },
    "confidence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "entity_refs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fighter_ids": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "bout_id": { "type": ["string", "null"] },
        "event_id": { "type": ["string", "null"] },
        "organization_ids": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "title_ids": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "commission_id": { "type": ["string", "null"] },
        "official_ids": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        }
      }
    },
    "facts": {
      "type": "object",
      "description": "Canonical structured facts permitted to flow into downstream story fact blocks. Unknown values must be absent or null; never fabricated."
    },
    "derived": {
      "type": "object",
      "description": "Optional PropBetEdge-derived context. Every derived block must carry its metric/model version.",
      "additionalProperties": true,
      "properties": {
        "version": { "type": "string" }
      },
      "required": ["version"]
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_key", "observed_at"],
        "properties": {
          "source_key": { "type": "string" },
          "source_url": { "type": ["string", "null"], "format": "uri" },
          "external_key": { "type": ["string", "null"] },
          "observed_at": { "type": "string", "format": "date-time" },
          "observation_id": { "type": ["string", "null"] }
        }
      }
    },
    "requires_human_review": {
      "type": "boolean",
      "default": false
    }
  }
}
